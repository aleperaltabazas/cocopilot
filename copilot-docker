#!/usr/bin/env bash
# copilot-docker: Run a Docker container with the host's Copilot auth token
# injected from the GNOME keyring, so no re-login is needed inside the container.
#
# Usage: copilot-docker [docker run args...] <image> [command...]
# Example: copilot-docker --rm -it my-image copilot

set -euo pipefail

_extract_token() {
    python3 - <<'PYEOF'
import sys
import dbus

try:
    bus = dbus.SessionBus()
except dbus.exceptions.DBusException:
    sys.exit(1)

service_obj = bus.get_object('org.freedesktop.secrets', '/org/freedesktop/secrets')
service = dbus.Interface(service_obj, 'org.freedesktop.Secret.Service')
_, session = service.OpenSession('plain', dbus.String('', variant_level=1))

collection_paths = service_obj.Get(
    'org.freedesktop.Secret.Service', 'Collections',
    dbus_interface='org.freedesktop.DBus.Properties'
)

for cpath in collection_paths:
    cobj = bus.get_object('org.freedesktop.secrets', cpath)
    try:
        items = cobj.Get('org.freedesktop.Secret.Collection', 'Items',
            dbus_interface='org.freedesktop.DBus.Properties')
    except Exception:
        continue
    for ipath in items:
        iobj = bus.get_object('org.freedesktop.secrets', ipath)
        attrs = iobj.Get('org.freedesktop.Secret.Item', 'Attributes',
            dbus_interface='org.freedesktop.DBus.Properties')
        if attrs.get('service') == 'copilot-cli':
            item_iface = dbus.Interface(iobj, 'org.freedesktop.Secret.Item')
            secret = item_iface.GetSecret(session)
            print(bytes(secret[2]).decode('utf-8'))
            sys.exit(0)

sys.exit(2)
PYEOF
}

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
COMPOSE_FILE="${SCRIPT_DIR}/docker-compose.yml"

TOKEN=$(_extract_token 2>/dev/null) || {
    echo "copilot-docker: could not read Copilot token from keyring." >&2
    echo "  Make sure you are logged in on the host ('copilot login') and" >&2
    echo "  the GNOME keyring daemon is running." >&2
    echo "  Falling back: container will need to run 'copilot login' manually." >&2
    exec docker compose -f "${COMPOSE_FILE}" run --rm cocopilot
}

exec docker compose -f "${COMPOSE_FILE}" run --rm -e "COPILOT_GITHUB_TOKEN=${TOKEN}" cocopilot
